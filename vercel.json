{
  "rewrites": [
    {
      "source": "/q/:codigo",
      "has": [
        {
          "type": "query",
          "key": "direct",
          "value": "false"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/n/:codigo",
      "has": [
        {
          "type": "query",
          "key": "direct",
          "value": "false"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/q/:codigo",
      "destination": "/api/redirect?tipo=qr&codigo=:codigo"
    },
    {
      "source": "/n/:codigo",
      "destination": "/api/redirect?tipo=nfc&codigo=:codigo"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
